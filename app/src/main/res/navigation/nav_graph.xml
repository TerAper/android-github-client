<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.yourname.githubclient.presentation.login.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_login_to_mainFlow"
            app:destination="@id/mainFlowFragment"
            app:popUpTo="@id/auth_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainFlowFragment"
        android:name="com.yourname.githubclient.presentation.main.MainFlowFragment"
        android:label="Main Flow" />

</navigation>
