<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_flow_graph"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileReposFragment"
        android:name="com.aper.presentation.ProfileReposFragment"
        android:label="Repositories" />

    <fragment
        android:id="@+id/allUsersFragment"
        android:name="com.aper.presentation.AllUsersFragment"
        android:label="Users">

        <action
            android:id="@+id/action_allUsersFragment_to_detailsFragment"
            app:destination="@id/usersDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/usersDetailsFragment"
        android:name="com.aper.presentation.DetailsFragment"
        android:label="Details">

        <argument
            android:name="login"
            app:argType="string" />

        <argument
            android:name="avatarUrl"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.aper.presentation.ProfileFragment"
        android:label="Profile">

        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.aper.presentation.SettingsFragment"
        android:label="Settings" />

</navigation>
