<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GithubClient"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>

        <!-- Toolbar -->
        <item name="toolbarStyle">@style/Widget.GithubClient.Toolbar</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.GithubClient.Toolbar"
        parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Splash -->
    <style name="Theme.GithubClient.Splash"
        parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GithubClient</item>
    </style>

</resources>
