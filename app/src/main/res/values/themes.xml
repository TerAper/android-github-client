<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GithubClient"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/teal_200</item>

        <item name="colorOnBackground">@color/on_background</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

    </style>

    <!-- Toolbar -->
    <style name="Widget.GithubClient.Toolbar"
        parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
    </style>


    <style name="Theme.GithubClient.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/on_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GithubClient</item>

    </style>

</resources>
